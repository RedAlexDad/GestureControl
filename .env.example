# Шаблон настроек приложения gesture-control.
#
# Скопируйте в `.env` рядом с этим файлом и правьте под своё железо:
#
#   cp .env.example .env
#
# Файл читается от текущего каталога вверх, поэтому искать его можно и в
# корне репозитория, и в `src-tauri`. Точный путь задаёт переменная
# `GESTURE_ENV_FILE`. Переменная окружения перекрывает значение из файла.
#
# Всё, чего здесь нет, берётся из значений по умолчанию в
# `src-tauri/src/config/settings.rs`. Ошибочное значение не мешает запуску: в
# журнал пишется предупреждение, и берётся значение по умолчанию.

# Размер окна приложения в логических пикселях. Раньше он жил в
# `tauri.conf.json`, но оттуда его нельзя перекрыть переменной окружения,
# поэтому окно собирается кодом и читает эти же ключи. Минимум больше
# размера — опечатка: минимум ужимается до размера, об этом пишется в журнал.
GESTURE_WINDOW_WIDTH=1180
GESTURE_WINDOW_HEIGHT=840
GESTURE_WINDOW_MIN_WIDTH=900
GESTURE_WINDOW_MIN_HEIGHT=640

# Устройство Video4Linux2, с которого идёт захват. Нужное устройство и его
# поддерживаемые режимы показывает `v4l2-ctl --list-devices`.
GESTURE_CAMERA_DEVICE=/dev/video0

# Размер кадра захвата в пикселях. Должен совпадать с режимом камеры,
# иначе ffmpeg подстроится сам и выдаст кадр другого размера.
GESTURE_CAMERA_WIDTH=640
GESTURE_CAMERA_HEIGHT=480

# Частота кадров захвата. Ноль и мусор отбрасываются, будет взят дефолт 30.
GESTURE_CAMERA_FPS=30

# Размер копии кадра для интерфейса. Кадр уходит как base64 в JSON-ответе,
# поэтому лишние пиксели здесь дорого стоят: 640x480 — это 921 600 байт
# RGB24 на кадр.
GESTURE_PREVIEW_WIDTH=640
GESTURE_PREVIEW_HEIGHT=480

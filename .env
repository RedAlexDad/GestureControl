# Настройки приложения gesture-control.
#
# Файл читается при запуске, каждая переменная перекрывает значение по
# умолчанию из `src-tauri/src/config/settings.rs`. Переменная окружения того
# же имени перекрывает значение здесь, поэтому разовый запуск с другим
# значением не требует правки файла:
#
#   GESTURE_CAMERA_FPS=15 make dev
#
# Ключи и допустимые значения описаны в `.env.example`.

# Размер окна приложения в логических пикселях.
GESTURE_WINDOW_WIDTH=1180
GESTURE_WINDOW_HEIGHT=840
GESTURE_WINDOW_MIN_WIDTH=900
GESTURE_WINDOW_MIN_HEIGHT=640

# Устройство Video4Linux2, с которого идёт захват.
GESTURE_CAMERA_DEVICE=/dev/video0

# Размер кадра захвата в пикселях.
GESTURE_CAMERA_WIDTH=640
GESTURE_CAMERA_HEIGHT=480

# Частота кадров захвата. Камера держит 30 кадров в секунду.
GESTURE_CAMERA_FPS=30

# Размер копии кадра, которая уходит в интерфейс. 640x480 совпадает с
# размером захвата, поэтому окно рисует кадр без уменьшения.
GESTURE_PREVIEW_WIDTH=640
GESTURE_PREVIEW_HEIGHT=480

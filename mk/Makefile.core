# Ядро, мосты и проверки качества.

include $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))/colors.mk

.PHONY: help check typecheck test clippy fmt bench clean

help:
	@printf '$(BOLD)Ядро и мосты$(RESET)\n\n'
	@printf '  $(BOLD)check$(RESET)      tsc, cargo test, clippy\n'
	@printf '  $(BOLD)typecheck$(RESET)  tsc --noEmit\n'
	@printf '  $(BOLD)test$(RESET)       cargo test --workspace\n'
	@printf '  $(BOLD)clippy$(RESET)     cargo clippy --all-targets\n'
	@printf '  $(BOLD)fmt$(RESET)        cargo fmt --check\n'
	@printf '  $(BOLD)bench$(RESET)      cargo bench\n'
	@printf '  $(BOLD)clean$(RESET)      cargo clean\n'

check: typecheck test clippy
	$(call done,Все проверки пройдены)

typecheck:
	$(call banner,TypeScript)
	$(call step,cd $(ROOT)/frontend && npx --no-install tsc --noEmit,tsc --noEmit)

test:
	$(call banner,Тесты ядра)
	$(call step,cd $(ROOT) && cargo test --workspace --offline,cargo test --workspace)
	$(call done,Тесты зелёные)

clippy:
	$(call banner,Clippy)
	$(call step,cd $(ROOT) && cargo clippy --workspace --all-targets --offline,cargo clippy --all-targets)
	$(call done,Clippy чист)

fmt:
	$(call banner,Форматирование)
	$(call step,cd $(ROOT) && cargo fmt --all -- --check,cargo fmt --check)
	$(call done,Форматирование верное)

bench:
	$(call banner,Бенчмарки)
	$(call step,cd $(ROOT) && cargo bench --workspace --offline,cargo bench)

clean:
	$(call banner,Очистка)
	$(call step,cd $(ROOT) && cargo clean,cargo clean)
	$(call done,Артефакты удалены)

# Tauri: dev с горячей перезагрузкой, релизная сборка и запуск.

include $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))/colors.mk

.PHONY: help dev release build info clean

help:
	@printf '$(BOLD)Tauri$(RESET)\n\n'
	@printf '  $(BOLD)dev$(RESET)      горячая перезагрузка: Rust и фронтенд\n'
	@printf '  $(BOLD)release$(RESET)  собрать в release и сразу запустить\n'
	@printf '  $(BOLD)build$(RESET)    собрать установщик в release\n'
	@printf '  $(BOLD)info$(RESET)     сведения об окружении Tauri\n'

# CLI лежит в node_modules фронтенда: глобальный cargo tauri не нужен.
# Определяется при разборе файла, чтобы видеть результат make.
TAURI := $(if $(wildcard $(TAURI_BIN)),$(TAURI_BIN),cd $(ROOT)/frontend && npx --no-install tauri)

# Уровень логов для dev. Свой код виден на info, шум зависимостей — на warn.
# Переопределяется из окружения: make dev DEV_LOG=gesture_control_lib=debug
DEV_LOG ?= gesture_control_lib=info,warn

dev:
	$(call banner,Dev с горячей перезагрузкой)
	$(call warn,нужен DISPLAY: окно откроется на этом компьютере)
	$(call info,RUST_LOG=$(DEV_LOG) — логи приложения идут в этот терминал)
	$(call step,cd $(ROOT) && RUST_LOG=$(DEV_LOG) $(TAURI) dev,tauri dev — Rust и фронтенд пересобираются сами)

release:
	$(call banner,Релизная сборка)
	$(call step,cd $(ROOT) && cargo build --release --manifest-path src-tauri/Cargo.toml --offline,сборка release)
	$(call done,Бинарь собран)
	$(call banner,Запуск)
	@printf '$(BOLD)$(GREEN)▶$(RESET) $(APP_BIN)\n'
	@$(APP_BIN)

build:
	$(call banner,Сборка установщика)
	$(call step,cd $(ROOT) && $(TAURI) build,tauri build — .deb и .AppImage)
	$(call done,Пакеты в src-tauri/target/release/bundle/)

info:
	$(call banner,Окружение)
	$(call step,cd $(ROOT) && $(TAURI) info,tauri info)

clean:
	$(call banner,Очистка)
	$(call step,rm -rf $(ROOT)/src-tauri/target/release/bundle,удаление bundle/)
	$(call done,bundle/ удалён)

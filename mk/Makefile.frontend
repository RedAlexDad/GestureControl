# Фронтенд на React + TypeScript + Vite.

include $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))/colors.mk

.PHONY: help dev build typecheck preview install clean

help:
	@printf '$(BOLD)Фронтенд$(RESET)\n\n'
	@printf '  $(BOLD)dev$(RESET)        dev-сервер Vite с горячей перезагрузкой\n'
	@printf '  $(BOLD)build$(RESET)      production-сборка в dist/\n'
	@printf '  $(BOLD)typecheck$(RESET)  tsc --noEmit\n'
	@printf '  $(BOLD)preview$(RESET)    предпросмотр собранного dist/\n'
	@printf '  $(BOLD)install$(RESET)    npm install\n'
	@printf '  $(BOLD)clean$(RESET)      удалить dist/\n'

dev:
	$(call banner,Dev-сервер Vite)
	$(call step,cd $(ROOT)/frontend && npm run dev,горячая перезагрузка на http://localhost:1420)

build:
	$(call banner,Сборка фронтенда)
	$(call step,cd $(ROOT)/frontend && npm run build,tsc + vite build в dist/)
	$(call done,dist/ готов)

typecheck:
	$(call banner,TypeScript)
	$(call step,cd $(ROOT)/frontend && npx --no-install tsc --noEmit,tsc --noEmit)

preview:
	$(call banner,Предпросмотр)
	$(call step,cd $(ROOT)/frontend && npm run preview,локальный просмотр dist/)

install:
	$(call banner,Зависимости)
	$(call step,cd $(ROOT)/frontend && npm install,npm install)
	$(call done,Зависимости установлены)

clean:
	$(call banner,Очистка)
	$(call step,rm -rf $(ROOT)/frontend/dist,удаление dist/)
	$(call done,dist/ удалён)

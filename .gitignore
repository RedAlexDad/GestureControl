# Артефакты сборки Rust
/target
/src-tauri/target
**/*.rs.bk

# Схемы прав, которые tauri-build собирает заново при каждой сборке
/src-tauri/gen

# Сборка фронтенда
/dist
/frontend/dist
/frontend/node_modules

# Данные приложения и словари жестов: это пользовательские файлы,
# а не часть исходников
*.json.bak

# Логи и временные файлы
*.log

# MediaPipe: библиотека C API и модель Hand Landmarker. Файлы большие,
# поэтому качаются scripts/fetch-models.sh, а не хранятся в git.
/models/libmediapipe.so
/models/hand_landmarker.task
